# ROAM — Environment Configuration
# Copy this file to .env and fill in values

# Google Gemini API key (required for live agent mode)
GEMINI_API_KEY=

# Optional: SerpAPI key for live web search
SERPAPI_KEY=

# Optional: OpenWeatherMap key for live weather
OPENWEATHER_KEY=

# Agent mode: "live" uses Gemini API, "demo" uses deterministic planner
AGENT_MODE=demo

# Security
MAX_INPUT_LENGTH=2000
MAX_TOOL_CALLS=50
TOOL_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_MINUTE=20

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
